<?php
require_once "includes/functions.php";
// '{baseurl}/DocumentRetrieval?DocumentTypes=WeightCertificate&ProNumber=056391174&AllInOneDocument=true&MediaType=pdf'
// need to use PEAR HTTP_Request2 or cURL
// base url is as follows:
// Production Environment: https://api.rlc.com
// api key: gtOzM2Ijk5O0U3ZjktOWIyYy00NDAwLWI4ODZTBlAxMTMGUGC
// MediaType is required so i may end up running the call 2x

// 10. Set the variables
$pro="975530088";
$typesURL = "https://api.rlc.com//DocumentRetrieval/GetDocumentTypes?ProNumber=".$pro;

// 20. Initialize cURL
$ch = curl_init($typesURL);

// 30. Set headers and options
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    'apiKey: gtOzM2Ijk5O0U3ZjktOWIyYy00NDAwLWI4ODZTBlAxMTMGUGC' // Replace with your actual key
]);

// 40. Execute and get the result
$response =curl_exec($ch);

// 50. set the result to be an array and access the DocumentTypes node 
$data = json_decode($response, true);
$availableDocs = $data['DocumentTypes'] ?? [];

// 60. Define search terms
$searchItems = ["WeightCertificate", "NmfcCertificate", "BillOfLading", "DeliveryReceipt", "Invoice"];

// 70. search for them
$matches = array_intersect($searchItems, $availableDocs);

// 80. Check for errors or output the data
if (curl_errno($ch)) {
    echo 'Error: ' . curl_error($ch);
    } else {
        // display search results
        if (!empty($matches)) {
            echo "The following docs are available: " . implode(", ", $matches);
        } else {
            echo "None of the requested documents were found.";
        }
        
        splooge($data);
        echo"";
        splooge($availableDocs);
    }


?>
